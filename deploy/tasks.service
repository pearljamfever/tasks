# Installed by the Tasks app installer.
[Unit]
Description=Tasks app (simple card-style task manager)
Documentation=https://github.com/pearljamfever/tasks
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tasks
Group=tasks
WorkingDirectory=/opt/tasks
# ./install replaces @NODE@ with the full path to node.
ExecStart=@NODE@ /opt/tasks/server.js
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=DATA_DIR=/var/lib/tasks
# Your settings (PORT, ALLOWED_HOSTS, KEEP_BACKUPS). This file is kept when you upgrade.
EnvironmentFile=-/etc/tasks.env
StateDirectory=tasks
StateDirectoryMode=0700
Restart=always
RestartSec=2
TimeoutStopSec=10

# Sandboxing: the app can only write to /var/lib/tasks and can't gain privileges.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
# Blocked system calls fail with "permission denied" instead of killing the app;
# Node probes a few optional calls at startup and falls back when refused.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
